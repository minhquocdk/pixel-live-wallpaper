<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/sand"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:layout_marginTop="2dp" />

        <!-- the seed -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/Section" android:text="@string/seed_label" />

            <EditText
                android:id="@+id/seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_seed"
                android:fontFamily="monospace"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/sand"
                android:textSize="17sp"
                android:autofillHints="none"
                android:importantForAutofill="no"
                android:contentDescription="@string/seed_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/random"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_quiet"
                    android:text="@string/random"
                    android:textAllCaps="false"
                    android:textColor="@color/sand"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/apply"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:text="@string/apply"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- the theme: the almanac's own island, or a MapleStory-inspired skin -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/Section" android:text="@string/theme" />

            <RadioGroup
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/theme_original"
                    style="@style/Choice"
                    android:text="@string/theme_original" />

                <RadioButton
                    android:id="@+id/theme_maple"
                    style="@style/Choice"
                    android:text="@string/theme_maple" />
            </RadioGroup>
        </LinearLayout>

        <!-- the picture's size, the frame rate, the length of a day -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/Section" android:text="@string/quality" />

            <RadioGroup
                android:id="@+id/quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/quality_auto"
                    style="@style/Choice"
                    android:text="@string/quality_auto" />

                <RadioButton
                    android:id="@+id/quality_low"
                    style="@style/Choice"
                    android:text="@string/quality_low" />

                <RadioButton
                    android:id="@+id/quality_medium"
                    style="@style/Choice"
                    android:text="@string/quality_medium" />

                <RadioButton
                    android:id="@+id/quality_high"
                    style="@style/Choice"
                    android:text="@string/quality_high" />
            </RadioGroup>

            <TextView
                style="@style/Section"
                android:layout_marginTop="14dp"
                android:text="@string/fps" />

            <RadioGroup
                android:id="@+id/fps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/fps_24"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fps_24"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/fps_30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fps_30"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/fps_60"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fps_60"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                style="@style/Section"
                android:layout_marginTop="14dp"
                android:text="@string/day" />

            <RadioGroup
                android:id="@+id/day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/day_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/day_5"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/day_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/day_10"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/day_20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/day_20"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/day_40"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/day_40"
                    android:textColor="@color/text" />
            </RadioGroup>
        </LinearLayout>

        <!-- what the wallpaper is doing right now -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Section" android:text="@string/status_title" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/not_set"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <Button
            android:id="@+id/set_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:text="@string/set_wallpaper"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/credits"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
